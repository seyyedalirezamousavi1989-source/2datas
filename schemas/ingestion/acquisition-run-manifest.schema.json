{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Offline Acquisition Simulation Manifest","type":"object","additionalProperties":false,"required":["schema_version","run_id","request_fingerprint","idempotency_key","plan_id","adapter_id","mode","started_at","status","pages_seen","records_seen","warnings","execution"],"properties":{"schema_version":{"const":"1.0.0"},"run_id":{"type":"string","minLength":1},"request_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"idempotency_key":{"type":"string","minLength":1},"plan_id":{"type":"string","minLength":1},"adapter_id":{"type":"string","minLength":1},"mode":{"const":"offline_fixture_only"},"started_at":{"type":"string","format":"date-time"},"status":{"enum":["simulated","blocked","failed"]},"pages_seen":{"type":"integer","minimum":0},"records_seen":{"type":"integer","minimum":0},"warnings":{"type":"array","items":{"type":"string"}},"execution":{"type":"object","additionalProperties":false,"required":["network_access","real_market_data_read","raw_artifact_written","dataset_written"],"properties":{"network_access":{"const":false},"real_market_data_read":{"const":false},"raw_artifact_written":{"const":false},"dataset_written":{"const":false}}}}}