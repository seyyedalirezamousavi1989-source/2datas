{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2datas.example/schemas/ingestion/ingestion-plan.schema.json",
  "title": "Offline Ingestion Readiness Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "source_id",
    "source_revision",
    "admission_decision_id",
    "target_use",
    "instrument_id",
    "provider_symbol",
    "timeframe",
    "range",
    "requested_modality",
    "output_contract",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "admission_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "target_use": {
      "const": "research"
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_symbol": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(m|h|d|w)$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "requested_modality": {
      "const": "ohlcv"
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "format",
        "preserve_raw_source"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/data/canonical-ohlcv-record.schema.json"
        },
        "format": {
          "const": "jsonl"
        },
        "preserve_raw_source": {
          "const": true
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "acquisition_authorized",
        "network_access",
        "market_data_read",
        "dataset_written",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "planned_only"
        },
        "acquisition_authorized": {
          "const": false
        },
        "network_access": {
          "const": false
        },
        "market_data_read": {
          "const": false
        },
        "dataset_written": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
