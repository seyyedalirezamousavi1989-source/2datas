{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Offline Source Adapter Descriptor","type":"object","additionalProperties":false,"required":["schema_version","adapter_id","adapter_version","provider_id","capabilities","timestamp_policy","bar_policy","pagination","retry_policy","network_enabled"],"properties":{"schema_version":{"const":"1.0.0"},"adapter_id":{"type":"string","minLength":1},"adapter_version":{"type":"string","minLength":1},"provider_id":{"type":"string","minLength":1},"capabilities":{"type":"array","items":{"const":"ohlcv"},"uniqueItems":true},"timestamp_policy":{"type":"object","additionalProperties":false,"required":["source_timezone","timestamp_semantics","conversion"],"properties":{"source_timezone":{"type":"string","minLength":1},"timestamp_semantics":{"enum":["bar_open","bar_close"]},"conversion":{"const":"to_utc"}}},"bar_policy":{"type":"object","additionalProperties":false,"required":["boundary","open_bar_handling","incomplete_bar_handling"],"properties":{"boundary":{"enum":["left_closed_right_open","provider_defined"]},"open_bar_handling":{"enum":["preserve_flag","exclude_by_request"]},"incomplete_bar_handling":{"const":"preserve_and_flag"}}},"pagination":{"type":"object","additionalProperties":false,"required":["mode","max_pages","cursor_reuse_policy"],"properties":{"mode":{"enum":["cursor","offset","none"]},"max_pages":{"type":"integer","minimum":1,"maximum":10000},"cursor_reuse_policy":{"const":"fail_closed"}}},"retry_policy":{"type":"object","additionalProperties":false,"required":["max_attempts","retryable_classes","backoff_seconds"],"properties":{"max_attempts":{"type":"integer","minimum":1,"maximum":10},"retryable_classes":{"type":"array","items":{"enum":["transient","rate_limited"]},"uniqueItems":true},"backoff_seconds":{"type":"number","minimum":0,"maximum":300}}},"network_enabled":{"const":false}}}