{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:2datas:schema:provenance:transformation-run:1",
  "title": "2datas Transformation Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "operation",
    "started_at",
    "status",
    "inputs",
    "outputs",
    "code",
    "configuration",
    "environment"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "ingest",
        "normalize",
        "validate",
        "feature_build",
        "label_build",
        "render",
        "sample",
        "split",
        "export",
        "evaluate",
        "other"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "partially_succeeded"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "urn:2datas:schema:provenance:artifact-manifest:1#/$defs/artifactReference"
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "urn:2datas:schema:provenance:artifact-manifest:1#/$defs/artifactReference"
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "working_tree"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "working_tree": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime"
      ],
      "properties": {
        "runtime": {
          "type": "string"
        },
        "dependency_lock_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-fA-F0-9]{64})?$"
        },
        "container_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "hardware_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone_database_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "random_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "determinism": {
      "enum": [
        "deterministic",
        "controlled_nondeterministic",
        "uncontrolled_nondeterministic",
        "not_applicable"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
