{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2datas.example/schemas/registry/data-source.schema.json",
  "title": "Data Source Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "revision",
    "provider",
    "feed_id",
    "source_type",
    "modalities",
    "asset_classes",
    "instruments",
    "supported_timeframes",
    "price_basis",
    "volume_semantics",
    "timestamp_convention",
    "availability",
    "license",
    "status",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "organization"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feed_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "broker",
        "exchange",
        "vendor",
        "public_dataset",
        "internal_synthetic"
      ]
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ohlcv",
          "quotes",
          "ticks",
          "order_book",
          "news",
          "fundamentals",
          "metadata",
          "synthetic"
        ]
      }
    },
    "asset_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument_id",
          "provider_symbol"
        ],
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_symbol": {
            "type": "string",
            "minLength": 1
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "supported_timeframes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*(m|h|d|w)$"
      }
    },
    "price_basis": {
      "enum": [
        "bid",
        "ask",
        "mid",
        "last",
        "mark",
        "index",
        "unknown",
        "not_applicable"
      ]
    },
    "volume_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning",
        "unit"
      ],
      "properties": {
        "meaning": {
          "enum": [
            "tick_volume",
            "traded_volume",
            "base_asset",
            "quote_asset",
            "contracts",
            "lots",
            "not_applicable",
            "unknown"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timestamp_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "timestamp_field_semantics",
        "bar_boundary"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_field_semantics": {
          "enum": [
            "bar_open",
            "bar_close",
            "event_time",
            "provider_defined",
            "unknown"
          ]
        },
        "bar_boundary": {
          "enum": [
            "open_inclusive_close_exclusive",
            "open_exclusive_close_inclusive",
            "instantaneous",
            "provider_defined",
            "unknown"
          ]
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_claim",
        "latency_evidence_type"
      ],
      "properties": {
        "latency_claim": {
          "type": [
            "string",
            "null"
          ]
        },
        "latency_evidence_type": {
          "enum": [
            "source_reported",
            "independently_verified",
            "unknown"
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "permissions"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "research",
            "model_training",
            "redistribution",
            "commercial"
          ],
          "properties": {
            "research": {
              "enum": [
                "allowed",
                "prohibited",
                "unknown"
              ]
            },
            "model_training": {
              "enum": [
                "allowed",
                "prohibited",
                "unknown"
              ]
            },
            "redistribution": {
              "enum": [
                "allowed",
                "prohibited",
                "unknown"
              ]
            },
            "commercial": {
              "enum": [
                "allowed",
                "prohibited",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "under_review",
        "approved",
        "rejected",
        "suspended",
        "retired"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered_at",
        "evidence_refs",
        "operator_id",
        "reviewer_id",
        "source_document_refs"
      ],
      "properties": {
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "operator_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_document_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "claim_type",
        "verification_status"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "license",
            "terms",
            "technical_metadata",
            "latency",
            "identity",
            "other"
          ]
        },
        "verification_status": {
          "enum": [
            "source_reported",
            "independently_verified",
            "unverified"
          ]
        }
      }
    }
  }
}
