{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2datas.example/schemas/registry/source-admission-decision.schema.json",
  "title": "Immutable Source Admission Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "source_id",
    "source_revision",
    "decision_timestamp",
    "target_use",
    "decision",
    "evidence_refs",
    "checks",
    "rationale",
    "reviewer_id",
    "policy_version",
    "revalidation_due"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "target_use": {
      "enum": [
        "research",
        "model_training",
        "redistribution",
        "commercial"
      ]
    },
    "decision": {
      "enum": [
        "admitted",
        "rejected",
        "needs_review"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "detail"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "review"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "revalidation_due": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
